GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BAUVO_LOCATION=global
BAUVO_MODEL=gemini-2.5-flash
# PDF-to-text only: one rendered page per request, always minimal reasoning.
BAUVO_OCR_PROVIDER=gemini
BAUVO_OCR_MODEL=gemini-3.5-flash
BAUVO_WORKERS=2
BAUVO_BATCH_SIZE=6
BAUVO_THINKING_BUDGET=2048

# Optional separate document-boundary proposals: auto or off (transcription only).
BAUVO_DOCUMENT_BOUNDARIES=auto
