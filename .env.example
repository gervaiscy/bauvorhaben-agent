GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BAUVO_LOCATION=global
BAUVO_MODEL=gemini-2.5-flash
BAUVO_WORKERS=2
BAUVO_BATCH_SIZE=6
BAUVO_THINKING_BUDGET=2048

# Pinned image-only OCR processor; OCR region is independent of BAUVO_LOCATION.
BAUVO_OCR_PROCESSOR=projects/222393655295/locations/eu/processors/6a00c6691fb66daa/processorVersions/pretrained-ocr-v2.1-2024-08-07
# Review threshold only; this is not an accuracy claim.
BAUVO_OCR_MIN_CONFIDENCE=0.98

# Optional document-boundary proposals: auto or off (OCR-only, no Gemini calls).
BAUVO_DOCUMENT_BOUNDARIES=auto
